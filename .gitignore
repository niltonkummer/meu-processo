# Local synthetic document fixtures (never commit PDFs)
.local/document-fixtures/*
!.local/document-fixtures/synthetic-worker/
.local/document-fixtures/synthetic-worker/*
!.local/document-fixtures/synthetic-worker/README.md

# Terraform local state and plans
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp
