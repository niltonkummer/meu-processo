# Firebase Web SDK identifiers are public configuration, not credentials.
# Production values must come from the reviewed Terraform output.
VITE_FIREBASE_BROWSER_KEY=demo-browser-key
VITE_FIREBASE_AUTH_DOMAIN=demo-meu-processo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-meu-processo
VITE_FIREBASE_APP_ID=demo-web-app
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Local Compose only. Production uses a private Cloud Run URL and Google ID tokens.
BROWSER_RENDERER_URL=http://browser-renderer:8080
BROWSER_RENDERER_AUTH_MODE=disabled

# Opcional: túnel privado autenticado para executar buscas com egress brasileiro.
# gcloud run services proxy djen-egress-test --region=southamerica-east1 --port=19090
DJEN_SEARCH_PROXY_URL=http://host.docker.internal:19090/search-djen
